<div class="ohm-widget ohm-circuit">
  <h3 class="ohm-widget-title">La legge di Ohm nel circuito</h3>
  <p class="ohm-widget-description">
    Modifica tensione e resistenza per osservare la variazione proporzionale della corrente e della velocità di carica.
  </p>

  <!-- Display delle grandezze -->
  <div class="grandezze fasorica-hud">
    <div class="grandezza metric-v">
      <h3>Tensione (<i>V</i>)</h3>
      <p><span class="particle-voltage">5.0</span> <small>V</small></p>
    </div>
    <div class="grandezza metric-r">
      <h3>Resistenza (<i>R</i>)</h3>
      <p><span class="particle-resistance">1.0</span> <small>kΩ</small></p>
    </div>
    <div class="grandezza metric-i">
      <h3>Corrente (<i>I</i>)</h3>
      <p><span class="particle-current">5.00</span> <small>mA</small></p>
    </div>
  </div>

  <!-- Schema SVG del circuito integrato -->
  <div class="circuit-container fasorica-circuit-frame">
    <svg
      class="circuit-svg"
      viewBox="0 0 800 320"
      role="img"
      aria-label="Circuito elettrico interattivo con batteria, resistore e carica in movimento"
    >
      <defs>
        <pattern id="fa-grid" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M 20 0 L 0 0 0 20" fill="none" stroke="var(--fa-border-light, #e5e5e0)" stroke-width="1" />
        </pattern>
        
        <filter id="fa-glow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="2.5" result="blur" />
          <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
      </defs>

      <rect width="800" height="320" rx="8" fill="url(#fa-grid)" opacity="0.6" />

      <!-- Tracciato di sfondo per la corrente -->
      <path
        class="circuit-wire-bg"
        d="M 120 140 V 70 H 340 L 350 50 L 365 90 L 380 50 L 395 90 L 410 50 L 425 90 L 440 50 L 450 70 H 680 V 250 H 120 V 180"
      />

      <!-- Filo Superiore (Arrivo al resistore) -->
      <path class="circuit-wire" d="M 120 150 V 70 H 340" />

      <!-- Resistore Zig-Zag (Passo uniforme 15px) -->
      <path
        class="circuit-resistor"
        d="
          M 340 70
          L 350 50
          L 365 90
          L 380 50
          L 395 90
          L 410 50
          L 425 90
          L 440 50
          L 450 70
        "
      />

      <!-- Filo Inferiore (Ritorno alla batteria) -->
      <path class="circuit-wire" d="M 450 70 H 680 V 250 H 120 V 170" />

      <!-- Batteria DC (Invariata) -->
      <g class="battery-group">
        <!-- Polo Positivo (+): Piastra lunga e sottile -->
        <line class="battery-plate battery-pos" x1="95" y1="150" x2="145" y2="150" />
        
        <!-- Polo Negativo (-): Piastra corta e spessa -->
        <line class="battery-plate battery-neg" x1="107" y1="170" x2="133" y2="170" />

        <!-- Segni di polarità -->
        <text class="battery-sign" x="155" y="136">+</text>
        <text class="battery-sign" x="155" y="190">−</text>

        <!-- Etichetta Tensione -->
        <text class="circuit-label v-label" x="65" y="166">V</text>
      </g>

      <!-- Etichetta Resistore -->
      <text class="circuit-label r-label" x="395" y="32" text-anchor="middle">R</text>

      <!-- Elettroni / Flusso di carica -->
      <g class="electrons">
        <circle class="electron" r="5" />
        <circle class="electron" r="5" />
        <circle class="electron" r="5" />
        <circle class="electron" r="5" />
        <circle class="electron" r="5" />
        <circle class="electron" r="5" />
        <circle class="electron" r="5" />
        <circle class="electron" r="5" />
        <circle class="electron" r="5" />
        <circle class="electron" r="5" />
        <circle class="electron" r="5" />
        <circle class="electron" r="5" />
        <circle class="electron" r="5" />
        <circle class="electron" r="5" />
      </g>
    </svg>
  </div>

  <!-- Pannello di Controllo -->
  <div class="ohm-controls-group">
    <div class="ohm-control">
      <label for="v-range">
        <span>Tensione (<i>V</i>)</span>
        <strong><span class="particle-voltage">5.0</span> V</strong>
      </label>
      <input
        id="v-range"
        class="particle-voltage-slider"
        type="range"
        min="0"
        max="10"
        step="0.1"
        value="5"
      />
    </div>

    <div class="ohm-control">
      <label for="r-range">
        <span>Resistenza (<i>R</i>)</span>
        <strong><span class="particle-resistance">1.0</span> kΩ</strong>
      </label>
      <input
        id="r-range"
        class="particle-resistance-slider"
        type="range"
        min="0.1"
        max="2"
        step="0.1"
        value="1"
      />
    </div>
  </div>

  <p class="particle-note">
    <strong>Nota:</strong> L'animazione rappresenta qualitativamente l'intensità di corrente <i>I</i> = <i>V</i> / <i>R</i>. La velocità del movimento delle cariche cresce proporzionalmente alla corrente calcolata.
  </p>
</div>

<script>
  const widgets = document.querySelectorAll('.ohm-circuit');

  widgets.forEach((widget) => {
    const voltageSlider = widget.querySelector('.particle-voltage-slider') as HTMLInputElement;
    const resistanceSlider = widget.querySelector('.particle-resistance-slider') as HTMLInputElement;

    const voltageValueDisplays = widget.querySelectorAll('.particle-voltage');
    const resistanceValueDisplays = widget.querySelectorAll('.particle-resistance');
    const currentValueDisplays = widget.querySelectorAll('.particle-current');

    const electrons = Array.from(widget.querySelectorAll('.electron')) as SVGCircleElement[];
    const positions = electrons.map((_, i) => i / electrons.length);

    // Tracciato sincronizzato con il passo di 15px uniforme su tutti i vertici
    const path = [
      { x: 120, y: 150 },
      { x: 120, y: 70 },
      { x: 340, y: 70 },

      { x: 350, y: 50 },
      { x: 365, y: 90 },
      { x: 380, y: 50 },
      { x: 395, y: 90 },
      { x: 410, y: 50 },
      { x: 425, y: 90 },
      { x: 440, y: 50 },
      { x: 450, y: 70 },

      { x: 680, y: 70 },
      { x: 680, y: 250 },
      { x: 120, y: 250 },
      { x: 120, y: 170 }
    ];

    const segments = [];
    let totalLength = 0;

    for (let i = 0; i < path.length - 1; i++) {
      const a = path[i];
      const b = path[i + 1];
      const length = Math.hypot(b.x - a.x, b.y - a.y);

      segments.push({
        a,
        b,
        length,
        start: totalLength
      });

      totalLength += length;
    }

    function getPoint(t: number) {
      let distance = (t % 1) * totalLength;
      if (distance < 0) distance += totalLength;

      for (const segment of segments) {
        if (distance <= segment.start + segment.length) {
          const local = (distance - segment.start) / segment.length;
          return {
            x: segment.a.x + (segment.b.x - segment.a.x) * local,
            y: segment.a.y + (segment.b.y - segment.a.y) * local
          };
        }
      }

      return path[path.length - 1];
    }

    function updateValues() {
      const voltage = Number(voltageSlider.value);
      const resistance = Number(resistanceSlider.value);
      const current = voltage / resistance;

      voltageValueDisplays.forEach(el => el.textContent = voltage.toFixed(1));
      resistanceValueDisplays.forEach(el => el.textContent = resistance.toFixed(1));
      currentValueDisplays.forEach(el => el.textContent = current.toFixed(2));
    }

    let lastTime = performance.now();

    function animate(time: number) {
      const delta = Math.min(time - lastTime, 50) / 1000;
      lastTime = time;

      const voltage = Number(voltageSlider.value);
      const resistance = Number(resistanceSlider.value);
      const current = voltage / resistance;

      const speed = current * 0.038;

      positions.forEach((position, index) => {
        positions[index] = (position + speed * delta) % 1;
        const point = getPoint(positions[index]);

        electrons[index].setAttribute('cx', point.x.toString());
        electrons[index].setAttribute('cy', point.y.toString());
      });

      requestAnimationFrame(animate);
    }

    voltageSlider.addEventListener('input', updateValues);
    resistanceSlider.addEventListener('input', updateValues);

    updateValues();
    requestAnimationFrame(animate);
  });
</script>

