<style is:global>

.fasorica-navbar {
  width: 100vw;
  height: 72px;

  margin: 0;
  padding: 0;

  background: #f8f7f3;
  border-bottom: 1px solid #e8e5df;

  box-sizing: border-box;
}

.fasorica-navbar-inner {
  width: 100%;
  height: 100%;

  margin: 0;
  padding: 0 48px;

  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;

  box-sizing: border-box;
}


/* =========================================================
   LOGO
   ========================================================= */

.fasorica-logo {
  justify-self: start;

  margin: 0;
  padding: 0;

  color: #252525 !important;

  font-family:
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    sans-serif !important;

  font-size: 17px !important;
  font-weight: 700 !important;
  line-height: 1 !important;
  letter-spacing: 0.04em !important;

  text-decoration: none !important;

  border: 0 !important;
  box-shadow: none !important;
}

.fasorica-logo:hover,
.fasorica-logo:focus,
.fasorica-logo:active {
  color: #252525 !important;
  background: transparent !important;

  text-decoration: none !important;
}


/* =========================================================
   LINK CENTRALI
   ========================================================= */

.fasorica-nav {
  justify-self: center;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 32px;

  margin: 0;
  padding: 0;
}

.fasorica-nav a {
  margin: 0;
  padding: 0;

  color: #55534f !important;
  background: transparent !important;

  font-family:
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    sans-serif !important;

  font-size: 14px !important;
  font-weight: 400 !important;
  line-height: 1 !important;

  text-decoration: none !important;

  border: 0 !important;
  box-shadow: none !important;

  transition: color 0.2s ease;
}

.fasorica-nav a:hover,
.fasorica-nav a:focus,
.fasorica-nav a:active {
  color: #252525 !important;
  background: transparent !important;

  text-decoration: none !important;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 700px) {

  .fasorica-navbar {
    height: 64px;
  }

  .fasorica-navbar-inner {
    padding: 0 20px;
    grid-template-columns: 1fr;
  }

  .fasorica-nav {
    display: none;
  }

}

</style>