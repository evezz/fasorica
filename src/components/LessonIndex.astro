---
import { argomenti } from '../data/lezioni';

// Le lezioni diventano cliccabili solo se esiste il file corrispondente in src/content/docs/it/.
const prefisso = '/src/content/docs/it/';
const esistenti = new Set(
  Object.keys(import.meta.glob('/src/content/docs/it/**/*.{md,mdx}')).map((p) =>
    p.slice(prefisso.length).replace(/\.mdx?$/, '').replace(/\/?index$/, '')
  )
);
const etichetta = { superiori: 'Superiori', universita: 'Università' };
---

<div class="lz">
  <div class="lz-controlli">
    <input class="lz-cerca" type="search" placeholder="Cerca una lezione…" aria-label="Cerca una lezione" />
    <div class="lz-filtri" role="group" aria-label="Filtra per livello">
      <button type="button" data-livello="tutti" aria-pressed="true">Tutti</button>
      <button type="button" data-livello="superiori" aria-pressed="false">Superiori</button>
      <button type="button" data-livello="universita" aria-pressed="false">Università</button>
    </div>
    <p class="lz-conteggio" aria-live="polite"></p>
  </div>

  <div class="lz-griglia">
    {argomenti.map((a, n) => (
      <section class="lz-argomento">
        <header class="lz-testata">
          <span class="lz-num">{String(n + 1).padStart(2, '0')}</span>
          <div>
            <h2>{a.titolo}</h2>
            <p>{a.descrizione}</p>
          </div>
        </header>
        <ul class="lz-lista">
          {a.lezioni.map((l) => {
            const pronta = esistenti.has(l.slug);
            return (
              <li class="lz-voce" data-livelli={l.livello.join(' ')}>
                <div class="lz-info">
                  {pronta ? (
                    <a class="lz-titolo" href={`/it/${l.slug}/`}>{l.titolo}</a>
                  ) : (
                    <span class="lz-titolo lz-spento">{l.titolo}</span>
                  )}
                  <p class="lz-desc">{l.descrizione}</p>
                </div>
                <div class="lz-meta">
                  {l.livello.map((x) => <span class="lz-tag">{etichetta[x]}</span>)}
                  {!pronta && <span class="lz-tag lz-arrivo">In arrivo</span>}
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
  <p class="lz-vuoto" hidden>Nessuna lezione trovata. Prova con un'altra parola.</p>
</div>

<style is:global>
  .lz { --lz-radius: 10px; }
  .lz [hidden] { display: none !important; }

  /* ---------- Controlli ---------- */
  .lz-controlli {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin: 0 0 2.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .lz-cerca {
    flex: 1 1 20rem;
    min-width: 0;
    padding: 0.65rem 1.1rem;
    font: inherit;
    font-size: 0.95rem;
    color: var(--sl-color-text);
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .lz-cerca::placeholder { color: var(--sl-color-gray-4); }
  .lz-cerca:hover { border-color: var(--sl-color-gray-4); }
  .lz-cerca:focus {
    outline: none;
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 3px var(--sl-color-accent-low);
  }

  .lz-filtri {
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
  }
  .lz-filtri button {
    padding: 0.35rem 0.9rem;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    color: var(--sl-color-gray-2);
    background: none;
    border: 0;
    border-radius: 999px;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .lz-filtri button:hover { color: var(--sl-color-text); }
  .lz-filtri button[aria-pressed='true'] {
    color: var(--sl-color-white);
    background: var(--sl-color-accent);
  }

  .lz-conteggio {
    margin: 0;
    margin-inline-start: auto;
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- Griglia argomenti ---------- */
  .lz-griglia {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 28rem), 1fr));
    gap: 3rem;
  }
  .lz-argomento { min-width: 0; }

  .lz-testata {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    margin-bottom: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  .lz-num {
    flex: none;
    padding-top: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--sl-color-accent-high);
    font-variant-numeric: tabular-nums;
  }
  .lz-testata h2 {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }
  .lz-testata p {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }

  /* ---------- Voci lezione ---------- */
  .lz-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .lz-voce {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0.85rem;
    border-radius: var(--lz-radius);
    transition: background 0.15s ease;
  }
  .lz-voce:hover { background: var(--sl-color-accent-low); }

  .lz-info { flex: 1 1 auto; min-width: 0; }
  .lz-titolo {
    display: inline-block;
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--sl-color-white);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  a.lz-titolo:hover { color: var(--sl-color-text-accent); }
  .lz-spento { color: var(--sl-color-gray-3); font-weight: 500; }

  .lz-desc {
    margin: 0.2rem 0 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }

  .lz-meta {
    flex: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.3rem;
    max-width: 10rem;
    padding-top: 0.15rem;
  }
  .lz-tag {
    padding: 0.1rem 0.55rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--sl-color-gray-2);
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    white-space: nowrap;
  }
  .lz-arrivo {
    color: var(--sl-color-gray-3);
    background: none;
    border-style: dashed;
  }

  .lz-vuoto {
    margin: 2.5rem 0 0;
    text-align: center;
    font-size: 0.95rem;
    color: var(--sl-color-gray-3);
  }

  @media (max-width: 40rem) {
    .lz-voce { flex-direction: column; gap: 0.5rem; padding: 0.85rem 0.9rem; }
    .lz-meta { justify-content: flex-start; max-width: none; padding-top: 0; }
    .lz-conteggio { flex-basis: 100%; margin-inline-start: 0; }
  }
</style>

<script>
  const radice = document.querySelector('.lz');
  if (radice) {
    const norm = (s) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const campo = radice.querySelector('.lz-cerca');
    const bottoni = [...radice.querySelectorAll('[data-livello]')];
    const voci = [...radice.querySelectorAll('.lz-voce')];
    const sezioni = [...radice.querySelectorAll('.lz-argomento')];
    const conteggio = radice.querySelector('.lz-conteggio');
    const vuoto = radice.querySelector('.lz-vuoto');
    const testi = voci.map((v) => norm(v.textContent));
    let livello = 'tutti';

    const filtra = () => {
      const parole = norm(campo.value).split(/\s+/).filter(Boolean);
      let visibili = 0;
      voci.forEach((v, i) => {
        const okLivello = livello === 'tutti' || v.dataset.livelli.split(' ').includes(livello);
        const ok = okLivello && parole.every((p) => testi[i].includes(p));
        v.hidden = !ok;
        if (ok) visibili++;
      });
      sezioni.forEach((s) => { s.hidden = !s.querySelector('.lz-voce:not([hidden])'); });
      conteggio.textContent = visibili === voci.length ? `${visibili} lezioni` : `${visibili} di ${voci.length} lezioni`;
      vuoto.hidden = visibili > 0;
    };

    campo.addEventListener('input', filtra);
    bottoni.forEach((b) =>
      b.addEventListener('click', () => {
        livello = b.dataset.livello;
        bottoni.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        filtra();
      })
    );
    filtra();
  }
</script>