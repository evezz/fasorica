---
import '../styles/home.css';
---

<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Fasorica</title>
    <meta
      name="description"
      content="Lezioni, appunti e strumenti interattivi per studiare elettronica e materie affini."
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <header class="navbar">
      <a href="/" class="logo">FASORICA</a>

      <nav class="nav-links">
        <a href="/chi-sono/">Chi sono</a>
        <a href="/contatti/">Contatti</a>
        <a href="/privacy/">Privacy</a>
      </nav>

      <a href="/it/" class="search" aria-label="Cerca">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-4-4"></path>
        </svg>
      </a>
    </header>

    <main class="hero">
        <img
            class="hero-background"
            src="/images/landingPage_background.jpg"
            alt=""
            aria-hidden="true"
        />

        <div class="hero-content">
            <h1>Una base di conoscenza<br />di elettronica ed elettrotecnica.</h1>

            <p class="subtitle">
            Lezioni, appunti e strumenti interattivi per capire
            l'elettronica e le materie affini.
            </p>

            <a href="/it/lezioni/" class="cta">
            Esplora le lezioni
            <span>→</span>
            </a>
        </div>
        </main>
  </body>
</html>