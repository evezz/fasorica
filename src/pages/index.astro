---
import '../styles/home.css';
import Navbar from '../components/Navbar.astro';
---

<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Fasorica</title>

    <meta
      name="description"
      content="Lezioni, appunti e strumenti interattivi per studiare elettronica e materie affini."
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <Navbar />

    <main class="hero">
      <img
        class="hero-background"
        src="/images/landingPage_background.jpg"
        alt=""
        aria-hidden="true"
      />

      <div class="hero-content">
        <h1>Biblioteca digitale<br />di elettronica ed elettrotecnica.</h1>

        <p class="subtitle">
          Lezioni, appunti e strumenti interattivi per capire
          l'elettronica e le materie affini.
        </p>

        <a href="/it/lezioni/" class="cta">
          Esplora le lezioni
          <span>→</span>
        </a>
      </div>
    </main>
  </body>
</html>